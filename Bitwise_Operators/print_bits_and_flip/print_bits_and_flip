#include <stdio.h>
#include <stdlib.h>

void	printbits(int	octet)
{
	unsigned char res;
	int	i;

	i = 7;
	while (i >= 0)
	{
		res = ((octet >> i) & 1) + '0';
		printf("%c", res);
		if (i == 4)
			printf(" ");
		i--;
	}
}

int	ft_flip_bits(int octet)
{
	unsigned char res;
	int	i;
	
	printf("step1: ");
	printbits(octet);
	printf("\nresult: %i\n", octet);
	octet = -octet;
	printf("_____________\n");
	printf("step2: ");
	printbits(octet);
	printf("\nreal: %i", (256 + octet));
	printf("\nresult: %i\n", octet);
}

int	main(int argc, char *argv[])
{
	ft_flip_bits(atoi(argv[1]));
	return (0);
}
